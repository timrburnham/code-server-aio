# Copy to k8s/config.env and fill in when enabling the Cloudflare Tunnel and
# Access protection. Then create/update the Secret:
#   kubectl -n code-server create secret generic code-server-config \
#     --from-env-file=k8s/config.env --dry-run=client -o yaml | kubectl apply -f -
#
# Until this Secret exists, code-server runs with the image defaults below and
# the access proxy stays blocked behind its 503 setup page (same as Compose).

# Required for remote access via a remotely managed Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# Required for origin JWT validation. Team hostname without https:// and the
# 64-character Application Audience (AUD) tag of the code-server Access app.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-64-character-application-audience

# Optional overrides (image defaults: true / 600). Once set here, changing a
# value requires re-running the kubectl command above; pod restarts pick it up.
# REPAIR_HOME_OWNERSHIP=true
# HOMEBREW_INSTALL_TIMEOUT=600
